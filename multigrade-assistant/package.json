{
  "name": "multigrade-teaching-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first teaching assistant for multi-grade classrooms: session planner, differentiated worksheets, rotation timer, progress tracker.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:report": "node scripts/check-report.js",
    "validate": "npm run check:report && npm run typecheck && npm test && npm run build",
    "samples": "vite-node scripts/make-samples.ts"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-node": "^2.0.5",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.0.5"
  }
}
